{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zhizhi",
  "version": "1.0.2",
  "identifier": "com.zhizhi.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "致知",
        "width": 1360,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "alwaysOnTop": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}